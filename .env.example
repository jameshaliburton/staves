# Variables for running Staves yourself. Everything here is optional: connecting a coding agent and
# drawing boards need none of it. The hosted service's own variables (Supabase, email, Slack, Ghost,
# platform telemetry) live in staves-cloud.

# Model keys, for interviews and reviews in the local browser app. They belong to the person running the
# local server or coding agent; never configure them on a shared host.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Scoped credential and public address for local CLI use.
STAVES_TOKEN=
STAVES_PUBLIC_URL=
# Set to 1 to allow the local rule-based interviewer without a model.
STAVES_RULE_INTERVIEWER=
# Local editor preview port; defaults to 4325.
STAVES_PREVIEW_PORT=

# Optional Langfuse evidence access for your own project, held only by the local coding agent.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Legacy origin alias; used only when LANGFUSE_BASE_URL is unset.
LANGFUSE_HOST=
